+  for (cur = event_callbacks; cur; cur = cur->next)
+    {
+      struct dl_phdr_info info;
+      fill_phdr_info (dso, &info);
+      cur->callback (&info, sizeof (info), cur->callback_data,
+		     is_unload);
+    }
+
+  GL(dl_mutations_forbidden) = false;
+}
