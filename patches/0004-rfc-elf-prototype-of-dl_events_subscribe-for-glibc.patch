+static void run_events_callbacks_locked (struct link_map *dso, int is_unload);
+
 /* Fallback implementation of _dl_find_object.  It uses a linear
    search, needs locking, and is not async-signal-safe.  It is used in
    _dl_find_object prior to initialization, when called from audit
    modules.  It also serves as the reference implementation for
    _dl_find_object.  */
 static int
 _dl_find_object_slow (void *pc, struct dl_find_object *result)
 {
   ElfW(Addr) addr = (ElfW(Addr)) pc;
   for (Lmid_t ns = 0; ns < GL(dl_nns); ++ns)
     for (struct link_map *l = GL(dl_ns)[ns]._ns_loaded; l != NULL;
          l = l->l_next)
       if (addr >= l->l_map_start && addr < l->l_map_end
           && (l->l_contiguous || _dl_addr_inside_object (l, addr)))
         {
           assert (ns == l->l_ns);
           struct dl_find_object_internal internal;
           _dl_find_object_from_map (l, &internal);
           _dl_find_object_to_external (&internal, result);
           return 0;
         }
 
   /* Object not found.  */
   return -1;
 }
 
 /* Data for the main executable.  There is usually a large gap between
    the main executable and initially loaded shared objects.  Record
    the main executable separately, to increase the chance that the
    range for the non-closeable mappings below covers only the shared
@@ -810,82 +812,272 @@ _dl_find_object_update_1 (struct link_map **loaded, size_t count)
   if (target_seg->previous != NULL)
     atomic_store_relaxed (&target_seg->previous->size, 0);
 
   _dlfo_mappings_end_update ();
   return true;
 }
 
 bool
 _dl_find_object_update (struct link_map *new_map)
 {
   /* Copy the newly-loaded link maps into an array for sorting.  */
   size_t count = 0;
   for (struct link_map *l = new_map; l != NULL; l = l->l_next)
     /* Skip proxy maps and already-processed maps.  */
     count += l == l->l_real && !l->l_find_object_processed;
   if (count == 0)
     return true;
 
   struct link_map **map_array = malloc (count * sizeof (*map_array));
   if (map_array == NULL)
     return false;
   {
     size_t i = 0;
     for (struct link_map *l = new_map; l != NULL; l = l->l_next)
       if (l == l->l_real && !l->l_find_object_processed)
         map_array[i++] = l;
   }
 
   _dl_find_object_link_map_sort (map_array, count);
   bool ok = _dl_find_object_update_1 (map_array, count);
+  if (ok)
+    /* Now that the maps are marked as processed, report them to
+       dl_events_subscribe callbacks.  */
+    for (size_t i = 0; i < count; ++i)
+      run_events_callbacks_locked (map_array[i], /*is_unload=*/ 0);
   free (map_array);
   return ok;
 }
 
 void
 _dl_find_object_dlclose (struct link_map *map)
 {
   uint64_t start_version = _dlfo_read_version_locked ();
   uintptr_t map_start = map->l_map_start;
 
+  run_events_callbacks_locked (map, /*is_unload=*/ 1);
 
   /* Directly patch the size information in the mapping to mark it as
      unused.  See the parallel lookup logic in _dl_find_object.  Do
      not check for previous dlclose at the same mapping address
      because that cannot happen (there would have to be an
      intermediate dlopen, which drops size-zero mappings).  */
   for (struct dlfo_mappings_segment *seg
          = _dlfo_mappings_active_segment (start_version);
        seg != NULL && seg->size > 0; seg = seg->previous)
     if (map_start >= seg->objects[0].map_start)
       {
         struct dl_find_object_internal *obj
           = _dlfo_lookup (map_start, seg->objects, seg->size);
         if (obj == NULL)
           /* Ignore missing link maps because of potential shutdown
              issues around __libc_freeres.  */
             return;
 
         /* Mark as closed.  This does not change the overall data
            structure, so no TM cycle is needed.  */
         atomic_store_relaxed (&obj->map_end, obj->map_start);
         atomic_store_relaxed (&obj->map, NULL);
         return;
       }
 }
 
 void
 _dl_find_object_freeres (void)
 {
   for (int idx = 0; idx < 2; ++idx)
     {
       for (struct dlfo_mappings_segment *seg = _dlfo_loaded_mappings[idx];
            seg != NULL; )
         {
           struct dlfo_mappings_segment *previous = seg->previous;
           free (seg->to_free);
           seg = previous;
         }
       /* Stop searching in shared objects.  */
       _dlfo_loaded_mappings[idx] = NULL;
     }
 }
+
+struct dl_events_subscription
+  {
+    struct dl_events_subscription *next;
+    struct dl_events_subscription **pprev;
+    struct dl_events_subscription *next_same_obj;
+    void (*callback) (struct dl_phdr_info *, size_t, void *, int is_unload);
+    void *callback_data;
+  };
+
+static struct dl_events_subscription *event_callbacks;
+
+/* Set to true at the start of _dl_fini to disable dl_events_subscribe facility. */
+static bool event_callbacks_terminated;
+
+void
+_dl_find_object_note_dl_fini (void)
+{
+  __rtld_lock_lock_recursive (GL(dl_load_lock));
+  event_callbacks_terminated = true;
+
+  for (Lmid_t ns = 0; ns < GL(dl_nns); ++ns)
+    for (struct link_map *l = GL(dl_ns)[ns]._ns_loaded; l != NULL; l = l->l_next)
+      l->l_events_subscriptions = NULL;
+
+  while (event_callbacks)
+    {
+      struct dl_events_subscription *cur = event_callbacks;
+      event_callbacks = cur->next;
+      free (cur);
+    }
+
+  __rtld_lock_unlock_recursive (GL(dl_load_lock));
+}
+
+static void
+fill_phdr_info (struct link_map *l, struct dl_phdr_info *info)
+{
+  /* fill_phdr_info is never invoked for proxy objects */
+  assert (l == l->l_real);
+
+  info->dlpi_addr = l->l_addr;
+  info->dlpi_name = l->l_name;
+  info->dlpi_phdr = l->l_phdr;
+  info->dlpi_phnum = l->l_phnum;
+  info->dlpi_adds = 0;
+  info->dlpi_subs = 0;
+  info->dlpi_tls_data = NULL;
+  info->dlpi_tls_modid = l->l_tls_modid;
+  if (info->dlpi_tls_modid != 0)
+    info->dlpi_tls_data = GLRO(dl_tls_get_addr_soft) (l);
+}
+
+int
+_dl_events_subscribe (void (*callback) (struct dl_phdr_info *, size_t,
+					void *, int is_unload),
+		      void *callback_data)
+{
+  /* Errors are reported as return values rather than via
+     _dl_signal_error, so that this can be called directly from a
+     libc.so loaded into a statically linked program (which has its
+     own exception handling and dlerror state).  */
+  struct dl_events_subscription *handle = malloc (sizeof (*handle));
+  if (handle == NULL)
+    return ENOMEM;
+
+  *handle = (struct dl_events_subscription){0};
+
+  /* The subscription is tied to the module containing the callback.
+     DL_LOOKUP_ADDRESS translates function descriptors (e.g. on hppa)
+     to code addresses.  */
+  ElfW(Addr) callback_addr = DL_LOOKUP_ADDRESS (callback);
+
+  __rtld_lock_lock_recursive (GL(dl_load_lock));
+
+  if (GL(dl_mutations_forbidden))
+    {
+      __rtld_lock_unlock_recursive (GL(dl_load_lock));
+      free (handle);
+      return EDEADLK;
+    }
+
+  struct link_map *match = _dl_find_dso_for_object (callback_addr);
+
+  if (event_callbacks_terminated
+      || (match != NULL && match->l_events_unsubscribed))
+    {
+      /* Either process exit has started and all subscriptions have
+	 been canceled, or the module containing the callback is being
+	 unloaded by dlclose and its subscriptions have already been
+	 canceled (e.g. we are called from its destructor).  Do not
+	 install the subscription, as nothing would cancel it, but
+	 still report the currently loaded modules below.  */
+      free (handle);
+    }
+  else
+    {
+      struct dl_events_subscription *old = event_callbacks;
+      handle->callback = callback;
+      handle->callback_data = callback_data;
+
+      handle->next = old;
+      handle->pprev = &event_callbacks;
+      if (old)
+	old->pprev = &handle->next;
+      event_callbacks = handle;
+
+      if (match)
+	{
+	  handle->next_same_obj = match->l_events_subscriptions;
+	  match->l_events_subscriptions = handle;
+	}
+    }
+
+  GL(dl_mutations_forbidden) = true;
+  for (Lmid_t ns = 0 ; ns < GL(dl_nns); ++ns)
+    for (struct link_map *l = GL(dl_ns)[ns]._ns_loaded; l != NULL; l = l->l_next)
+      {
+	/* See run_events_callbacks_locked for why unprocessed maps are
+	   skipped.  If loading succeeds, they will be reported by
+	   _dl_find_object_update.  */
+	if (l != l->l_real || !l->l_find_object_processed)
+	  continue;
+	struct dl_phdr_info info;
+	fill_phdr_info (l, &info);
+	callback (&info, sizeof (info), callback_data, /*is_unload=*/ 0);
+      }
+  GL(dl_mutations_forbidden) = false;
+
+  __rtld_lock_unlock_recursive (GL(dl_load_lock));
+  return 0;
+}
+
+void
+_dl_find_object_pre_dlclose (struct link_map *map)
+{
+  struct dl_events_subscription *cur = map->l_events_subscriptions;
+  map->l_events_subscriptions = NULL;
+  map->l_events_unsubscribed = 1;
+  while (cur)
+    {
+      struct dl_events_subscription *h = cur;
+      struct dl_events_subscription *next = h->next;
+      cur = cur->next_same_obj;
+
+      if (next)
+        next->pprev = h->pprev;
+
+      *(h->pprev) = next;
+      free (h);
+    }
+}
+
+static void
+run_events_callbacks_locked (struct link_map *dso, int is_unload)
+{
+  struct dl_events_subscription *cur;
+
+  /* Only report maps that have been processed by _dl_find_object.
+     A map that failed to load before reaching _dl_find_object_update
+     may not have been fully set up (e.g. its TLS module ID is
+     assigned, but not yet registered in the slotinfo list, which
+     makes _dl_tls_get_addr_soft unsafe).  Such maps have not been
+     reported as loaded either.  */
+  if (dso != dso->l_real || !dso->l_find_object_processed)
+    return;
+
+  if (event_callbacks == NULL)
+    return;
+
+  assert (!GL(dl_mutations_forbidden));
+  GL(dl_mutations_forbidden) = true;
+
